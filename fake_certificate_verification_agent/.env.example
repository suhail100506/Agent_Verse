# Groq / Grok API Key for AI Agents
GROQ_API_KEY=your_groq_api_key_here
GROK_API_KEY=your_grok_api_key_here
XAI_API_KEY=your_xai_api_key_here

# MongoDB Connection String (For MongoDB Compass & PyMongo)
# For local MongoDB Compass instance:
MONGODB_URI=mongodb://localhost:27017

# For MongoDB Atlas Cloud instance:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority

DATABASE_NAME=certificate_verifier

# OpenAI API Key (Required for live CrewAI agent reasoning)
OPENAI_API_KEY=your_openai_api_key_here
# Application Settings
PORT=8000
HOST=0.0.0.0
