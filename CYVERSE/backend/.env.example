# Groq / Grok API Key for AI Agents (OPTIONAL - server-wide fallback only)
# Recommended: instead of setting this, add your Groq key from the running app's
# UI (Sidebar > Credentials tab, or a node's popup > Credentials tab). Keys added
# there are stored encrypted in the vault and can be bound per-node. Any node with
# no credential bound falls back to the key set here, if present.
# GROK_API_KEY=your_grok_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
GROK_API_KEY=your_grok_api_key_here
XAI_API_KEY=your_xai_api_key_here

# MongoDB Connection String (view live in MongoDB Compass with this same URI) (OPTIONAL - server-wide fallback only)
# Recommended: instead of setting this, add a "MongoDB Connection" credential from
# the app's UI (Sidebar > Credentials tab, or a node's popup > Credentials tab).
# That's stored encrypted in the vault and takes priority over these env vars.
# For local MongoDB Compass instance:
MONGODB_URI=mongodb://localhost:27017

# For MongoDB Atlas Cloud instance:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority

DATABASE_NAME=certificate_verifier

# OpenAI API Key (Required for live CrewAI agent reasoning)
OPENAI_API_KEY=your_openai_api_key_here
# Application Settings
PORT=8000
HOST=0.0.0.0

# Credential Vault Encryption Key (Fernet key)
# Generate one with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If left unset, a temporary key is generated per-process (dev only - credentials
# will not survive a server restart until you set a permanent key here).
VAULT_ENCRYPTION_KEY=

# SMTP fallback credentials (used when a node has no bound SMTP credential)
EMAIL_USER=
EMAIL_PASS=
